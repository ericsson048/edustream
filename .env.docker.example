# Copy this file to .env.docker before starting Docker Compose.
# Replace 192.168.1.50 with the reserved local IP address of this machine.
POSTGRES_DB=edustream
POSTGRES_USER=edustream
POSTGRES_PASSWORD=replace-with-a-long-random-password

DJANGO_SECRET_KEY=replace-with-a-long-random-django-secret
DJANGO_DEBUG=false
DJANGO_SECURE=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,192.168.1.50
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://192.168.1.50:3000
FRONTEND_BASE_URL=http://192.168.1.50:3000
TZ=Africa/Johannesburg

USE_REDIS_CHANNELS=true
USE_REDIS_CACHE=true

# Add real provider credentials only when those features are configured.
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# Optional SMTP delivery. Without credentials, emails are printed to backend logs.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=your-address@gmail.com
EMAIL_HOST_PASSWORD=your-gmail-app-password
DEFAULT_FROM_EMAIL=your-address@gmail.com

# Optional TURN REST API shared secret; the backend issues one-hour credentials.
WEBRTC_TURN_URLS=
WEBRTC_TURN_SHARED_SECRET=
