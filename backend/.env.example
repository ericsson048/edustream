DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
TZ=Africa/Johannesburg
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database (SQLite for local dev, PostgreSQL in production)
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=db.sqlite3

# Stripe
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
FRONTEND_BASE_URL=http://127.0.0.1:3000

# Email (keep credentials out of source control)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=EduStream <noreply@example.com>

# AI
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# Channels / Redis
USE_REDIS_CHANNELS=true
CHANNEL_BACKEND=channels_redis.core.RedisChannelLayer
REDIS_URL=redis://127.0.0.1:6379/0

# Cache
USE_REDIS_CACHE=true
CACHE_BACKEND=django.core.cache.backends.redis.RedisCache
DJANGO_CACHE_URL=redis://127.0.0.1:6379/1
DJANGO_CACHE_KEY_PREFIX=edustream
DJANGO_CACHE_TIMEOUT=300

# Optional TURN REST API shared secret. Do not use a static TURN password.
WEBRTC_TURN_URLS=
WEBRTC_TURN_SHARED_SECRET=
